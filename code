// ============================================================
// MINE VEHICLE SAFETY SYSTEM
// Arduino UNO + 5 Ultrasonic Sensors + L298N
// Buzzer + Green/Yellow/Red LED
// ============================================================

// ---------------- ULTRASONIC SENSOR PINS ----------------

// Front Left
#define FL_TRIG 2
#define FL_ECHO 3

// Front Center
#define FC_TRIG 4
#define FC_ECHO 5

// Front Right
#define FR_TRIG 6
#define FR_ECHO 7

// Left Side
#define L_TRIG 8
#define L_ECHO 9

// Right Side
#define R_TRIG A0
#define R_ECHO A1


// ---------------- MOTOR DRIVER PINS ----------------

#define IN1 10
#define IN2 11
#define IN3 12
#define IN4 13


// ---------------- ALERT PINS ----------------

#define GREEN_LED A2
#define YELLOW_LED A3
#define RED_LED A4
#define BUZZER A5


// ---------------- SAFETY DISTANCES ----------------

#define SAFE_DISTANCE 200
#define WARNING_DISTANCE 100
#define DANGER_DISTANCE 50


// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(9600);

  // Ultrasonic pins
  pinMode(FL_TRIG, OUTPUT);
  pinMode(FL_ECHO, INPUT);

  pinMode(FC_TRIG, OUTPUT);
  pinMode(FC_ECHO, INPUT);

  pinMode(FR_TRIG, OUTPUT);
  pinMode(FR_ECHO, INPUT);

  pinMode(L_TRIG, OUTPUT);
  pinMode(L_ECHO, INPUT);

  pinMode(R_TRIG, OUTPUT);
  pinMode(R_ECHO, INPUT);


  // Motor pins
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);


  // Alert pins
  pinMode(GREEN_LED, OUTPUT);
  pinMode(YELLOW_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);
  pinMode(BUZZER, OUTPUT);


  // Initial condition
  stopVehicle();

  digitalWrite(GREEN_LED, HIGH);
  digitalWrite(YELLOW_LED, LOW);
  digitalWrite(RED_LED, LOW);
  digitalWrite(BUZZER, LOW);

  delay(1000);
}


// ============================================================
// ULTRASONIC DISTANCE FUNCTION
// ============================================================

long getDistance(int trigPin, int echoPin)
{
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 30000);

  // If no echo received
  if (duration == 0)
  {
    return 400;
  }

  long distance = duration * 0.034 / 2;

  return distance;
}


// ============================================================
// VEHICLE FORWARD
// ============================================================

void moveForward()
{
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}


// ============================================================
// VEHICLE STOP
// ============================================================

void stopVehicle()
{
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}


// ============================================================
// ALERT FUNCTIONS
// ============================================================

void safeAlert()
{
  digitalWrite(GREEN_LED, HIGH);
  digitalWrite(YELLOW_LED, LOW);
  digitalWrite(RED_LED, LOW);

  digitalWrite(BUZZER, LOW);
}


void warningAlert()
{
  digitalWrite(GREEN_LED, LOW);
  digitalWrite(YELLOW_LED, HIGH);
  digitalWrite(RED_LED, LOW);

  // Slow beep
  digitalWrite(BUZZER, HIGH);
  delay(100);
  digitalWrite(BUZZER, LOW);
}


void dangerAlert()
{
  digitalWrite(GREEN_LED, LOW);
  digitalWrite(YELLOW_LED, LOW);
  digitalWrite(RED_LED, HIGH);

  // Continuous buzzer
  digitalWrite(BUZZER, HIGH);
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop()
{
  // Read all 5 sensors

  long frontLeft = getDistance(FL_TRIG, FL_ECHO);
  delay(20);

  long frontCenter = getDistance(FC_TRIG, FC_ECHO);
  delay(20);

  long frontRight = getDistance(FR_TRIG, FR_ECHO);
  delay(20);

  long leftSide = getDistance(L_TRIG, L_ECHO);
  delay(20);

  long rightSide = getDistance(R_TRIG, R_ECHO);
  delay(20);


  // ----------------------------------------------------------
  // Display sensor values
  // ----------------------------------------------------------

  Serial.println("--------------------------------");

  Serial.print("Front Left   : ");
  Serial.print(frontLeft);
  Serial.println(" cm");

  Serial.print("Front Center : ");
  Serial.print(frontCenter);
  Serial.println(" cm");

  Serial.print("Front Right  : ");
  Serial.print(frontRight);
  Serial.println(" cm");

  Serial.print("Left Side    : ");
  Serial.print(leftSide);
  Serial.println(" cm");

  Serial.print("Right Side   : ");
  Serial.print(rightSide);
  Serial.println(" cm");


  // ----------------------------------------------------------
  // Find nearest obstacle
  // ----------------------------------------------------------

  long nearestDistance = frontLeft;

  if (frontCenter < nearestDistance)
    nearestDistance = frontCenter;

  if (frontRight < nearestDistance)
    nearestDistance = frontRight;

  if (leftSide < nearestDistance)
    nearestDistance = leftSide;

  if (rightSide < nearestDistance)
    nearestDistance = rightSide;


  Serial.print("Nearest Obstacle: ");
  Serial.print(nearestDistance);
  Serial.println(" cm");


  // ----------------------------------------------------------
  // SAFETY LOGIC
  // ----------------------------------------------------------

  if (nearestDistance > SAFE_DISTANCE)
  {
    // SAFE
    Serial.println("STATUS: SAFE");

    safeAlert();

    moveForward();
  }

  else if (nearestDistance > DANGER_DISTANCE)
  {
    // WARNING
    Serial.println("STATUS: WARNING");

    warningAlert();

    // Vehicle continues
    moveForward();
  }

  else
  {
    // DANGER / CRITICAL
    Serial.println("STATUS: DANGER - VEHICLE STOPPED");

    dangerAlert();

    // Automatically stop vehicle
    stopVehicle();
  }


  delay(100);
}
